# PostgreSQL
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=changeme
POSTGRES_DB=transcendence_db
DATABASE_URL="postgresql://transcendence:changeme@postgres:5432/transcendence_db"

# Backend
NODE_ENV=production
PORT=3000
JWT_SECRET=changeme_use_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend
VITE_API_URL=https://localhost:8443/api
VITE_WS_URL=wss://localhost:8443

# OAuth 42
FORTY_TWO_CLIENT_ID=changeme
FORTY_TWO_CLIENT_SECRET=changeme
FORTY_TWO_CALLBACK_URL=https://localhost:8443/api/auth/42/callback

# OAuth GitHub
GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
GITHUB_CALLBACK_URL=https://localhost:8443/api/auth/github/callback

# 2FA
TWO_FACTOR_APP_NAME=ft_transcendence
