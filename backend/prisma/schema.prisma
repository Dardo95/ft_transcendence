generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS ──────────────────────────────────────────────────
model User {
  id             Int      @id @default(autoincrement())
  username       String   @unique
  email          String   @unique
  password       String?  // null when the user logs in via OAuth
  avatarUrl      String?  // null = default avatar
  xp             Int      @default(0)
  isOnline       Boolean  @default(false)
  twoFaSecret    String?
  twoFaEnabled   Boolean  @default(false)
  oauthProvider  String?  // "google", "42", etc.
  oauthId        String?
  createdAt      DateTime @default(now())

  // relations
  matchPlayers      MatchPlayer[]
  sentFriendships   Friendship[]  @relation("requester")
  receivedFriendships Friendship[] @relation("addressee")

  @@map("users")
}

// ─── MATCHES ────────────────────────────────────────────────
model Match {
  id          Int         @id @default(autoincrement())
  status      MatchStatus @default(WAITING)
  gameMode    GameMode    @default(CLASSIC)
  maxPlayers  Int         @default(4)
  mapId       String?
  createdAt   DateTime    @default(now())
  finishedAt  DateTime?

  players          MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id        Int     @id @default(autoincrement())
  matchId   Int
  userId    Int
  score     Int     @default(0)
  kills     Int     @default(0)
  position  Int?
  result    MatchPlayerResult?

  // Inherit field for compatibility
  isWinner  Boolean @default(false)

  match  Match @relation(fields: [matchId], references: [id])
  user   User  @relation(fields: [userId], references: [id])

  @@unique([matchId, userId])
  @@map("match_players")
}

// ─── FRIENDSHIPS ────────────────────────────────────────────
model Friendship {
  id           Int              @id @default(autoincrement())
  requesterId  Int
  addresseeId  Int
  status       FriendshipStatus @default(PENDING)
  createdAt    DateTime         @default(now())

  requester  User @relation("requester", fields: [requesterId], references: [id])
  addressee  User @relation("addressee", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

// ─── ENUMS ──────────────────────────────────────────────────
enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum GameMode {
  CLASSIC
  TOURNAMENT
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum MatchPlayerResult {
  WIN
  LOSS
  DRAW
}