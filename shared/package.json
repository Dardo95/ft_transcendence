{
  "name": "@transcendence/shared",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "pnpm exec tsc -b",
    "format": "pnpm exec prettier --write \"src/**/*.ts\"",
    "format:check": "pnpm exec prettier --check \"src/**/*.ts\"",
    "typecheck": "pnpm exec tsc --noEmit --incremental false -p tsconfig.json",
    "lint": "oxlint --type-aware src/",
    "test": "echo 'No tests configured for shared package'"
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "oxlint": "^1.58.0"
  }
}
